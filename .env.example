# --- Public URL / Traefik routing ---
DOMAIN=example.com
ROOT_URL=https://example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- MongoDB credentials (required) ---
# Generate strong values, e.g. `openssl rand -base64 24`
MONGO_INITDB_ROOT_USERNAME=communitymanager
MONGO_INITDB_ROOT_PASSWORD=change-me-to-a-strong-secret

# --- Optional overrides ---
# Full MONGO_URL wins over user/pass if set explicitly
# MONGO_URL=mongodb://user:pass@mongo:27017/community-manager?authSource=admin

# JSON string passed to Meteor.settings (see settings.example.json)
# METEOR_SETTINGS={"public":{},"private":{}}
